COMPOSE_PROJECT_NAME=openwebui
COMPOSE_DOMAIN=webui.local.itkdev.dk

WEBUI_SECRET_KEY=CHANGE_ME_NOW

OAUTH_CLIENT_ID=XXXXX
OAUTH_CLIENT_SECRET=XXXX
OPENID_PROVIDER_URL=https://aarhuskommunetest.b2clogin.com/aarhuskommunetest.onmicrosoft.com/v2.0/.well-known/openid-configuration?p=B2C_1A_AAK_SIGNIN_OIDC_AIPLATFORM

OPENAI_API_BASE_URLS='https://stgxxxx.itkdev.dk/v1;https://xxxx.itkdev.dk'
OPENAI_API_KEYS='sk-XXXX;sk-XXXX'

RAG_OPENAI_API_KEY=XXXX

OAUTH_PROVIDER_NAME="Aarhus Kommune"
OAUTH_SCOPES="openid email"
OAUTH_EMAIL_CLAIM=upn
OAUTH_ROLES_CLAIM=role
OAUTH_ADMIN_ROLES=admin
OAUTH_ALLOWED_ROLES=admin,end-user,local-admin,builder
ENABLE_OAUTH_ROLE_MANAGEMENT=true
#AAK_OAUTH_DEBUG_FORCE_ROLE=builder

ENABLE_LOGIN_FORM=TRUE
ENABLE_SIGNUP=TRUE

ENABLE_OTEL=false
ENABLE_OTEL_METRICS=false

TTS_API_KEY=XXXX
STT_API_KEY=XXXX

GLOBAL_LOG_LEVEL=DEBUG
ENABLE_PERSISTENT_CONFIG=false

WEBUI_ADMIN_EMAIL=noreply@itkdev.dk
WEBUI_ADMIN_PASSWORD=admin

## Search agentic
SEARCH_AGENT_SEARCH_PROVIDER=staan
SEARCH_AGENT_STAAN_API_KEY=stn_XXXX
SEARCH_AGENT_LLM_BASE_URL=https://XXXX.itkdev.dk/v1
SEARCH_AGENT_LLM_API_KEY=sk-XXXX
SEARCH_AGENT_LLM_MODEL=AarhusAI-default-v2
SEARCH_AGENT_DEBUG=true
SEARCH_AGENT_SEARCH_FETCH_PAGE_CONTENT=true


## Ingestion
INGESTION_API_KEY=XXXX

INGESTION_DEBUG=false
INGESTION_LOG_LEVEL=INFO
INGESTION_LOG_LEVEL_APP=INFO

EXTERNAL_INGESTION_ENGINE=external
INGESTION_EMBEDDING_API_KEY=XXXX

INGESTION_VISION_LLM_API_BASE_URL=https://XXXX.itkdev.dk/v1
INGESTION_VISION_LLM_API_KEY=sk-XXXX
INGESTION_VISION_LLM_MODEL=AarhusAI-default-v2

## RAG agent
RETRIEVAL_API_KEY=XXXX

RETRIEVAL_LOG_LEVEL_APP=INFO
RETRIEVAL_LOG_LEVEL=INFO

RETRIEVAL_AGENT_API_BASE_URL=https://XXXX.itkdev.dk/v1
RETRIEVAL_AGENT_API_KEY=sk-XXXX
RETRIEVAL_AGENT_MODEL=AarhusAI-default-v2

RETRIEVAL_EMBEDDING_API_BASE_URL=https://XXXX.itkdev.dk/v1
RETRIEVAL_EMBEDDING_API_KEY=XXXX
RETRIEVAL_EMBEDDING_MODEL=intfloat/multilingual-e5-large

RETRIEVAL_ENABLE_RERANKING=true
RETRIEVAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_RERANKER_API_BASE_URL=https://XXXX.itkdev.dk/rerank
RETRIEVAL_RERANKER_API_KEY=XXXX

# Event database agent
EVENT_DATABASE_SERVICE_API_KEY=XXXX
EVENT_DATABASE_AGENT_API_KEY=sk-XXXX
EVENT_DATABASE_BASE_URL=https://api.detskeriaarhus.dk/api/v2
EVENT_DATABASE_API_KEY=XXXX

# Retsinformation API agent
RETSINFORMATION_SERVICE_API_KEY=XXXX
RETSINFORMATION_LLM_API_KEY=sk-XXXX

# EU Founding
EU_FOUNDING_SERVICE_API_KEY=XXXX
EU_FOUNDING_AGENT_API_KEY=sk-XXXX
